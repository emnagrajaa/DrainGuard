# Copy this file to .env and fill in real values. .env itself is
# gitignored — never commit real secrets.

# Postgres/TimescaleDB connection (matches docker-compose.yml defaults
# below). Leave unset / comment out to fall back to local SQLite.
DATABASE_URL=postgresql://drainguard:drainguard@localhost:5432/drainguard

# OpenWeatherMap API key (One Call API 3.0 — free tier covers this
# project's usage easily: https://openweathermap.org/api/one-call-3).
# Leave unset and weather_client.py falls back to a mock generator so
# the pipeline still runs without a key.
OWM_API_KEY=
